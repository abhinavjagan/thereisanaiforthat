# API Keys (get your own)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aitools
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/aitools

# GitHub — https://github.com/settings/tokens
GITHUB_TOKEN=

# Product Hunt — https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=

# Reddit — https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=aitools-aggregator/1.0

# OpenAI (for LLM enrichment only) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# App settings
LOG_LEVEL=INFO
LLM_ENRICHMENT_ENABLED=false
LLM_MAX_PER_DAY=100
